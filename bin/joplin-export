#!/bin/bash

set -eou pipefail

TMPD="$(mktemp -d /tmp/$(basename $0).XXXXXX)"
trap cleanup EXIT
cleanup() {
    rm -rf "$TMPD"
}

# -- Joplin Backup
JOPLIN_CLI=/home/amichaux/Development/github-repos/shell-scripts/bin/joplin-cli
export JOPLIN_EXPORT_DIR=$TMPD/joplin-backup
mkdir -p $JOPLIN_EXPORT_DIR
$JOPLIN_CLI export --format md_frontmatter /export
tree $TMPD/joplin-backup
JOPLIN_DIR=$HOME/Documents/Joplin
rsync -acv --delete $JOPLIN_EXPORT_DIR/ $JOPLIN_DIR/

